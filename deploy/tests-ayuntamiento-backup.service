[Unit]
Description=Consistent backup of Tests Ayuntamiento SQLite

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/tests-ayuntamiento
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tests-ayuntamiento/venv/bin/python /opt/tests-ayuntamiento/deploy/sqlite-backup.py
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/tests-ayuntamiento
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
MemoryMax=256M
CPUQuota=25%
TasksMax=8
