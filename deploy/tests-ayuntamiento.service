[Unit]
Description=Tests Ayuntamiento SQLite API
After=network.target

[Service]
Type=simple
User=tests-ayuntamiento
Group=tests-ayuntamiento
WorkingDirectory=/opt/tests-ayuntamiento
EnvironmentFile=/etc/tests-ayuntamiento/api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/tests-ayuntamiento/venv/bin/python -m server.app
Restart=on-failure
RestartSec=5
StateDirectory=tests-ayuntamiento
StateDirectoryMode=0700
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=192M
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
